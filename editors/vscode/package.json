{
  "name": "supa-mdx-lint",
  "displayName": "supa-mdx-lint",
  "description": "MDX/Markdown linter for Supabase documentation",
  "version": "0.1.0",
  "publisher": "supabase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/supabase-community/supa-mdx-lint"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:mdx"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "supa-mdx-lint",
      "properties": {
        "supa-mdx-lint.lintOn": {
          "type": "string",
          "enum": [
            "save",
            "type"
          ],
          "default": "type",
          "description": "When to lint documents: on save or as you type"
        },
        "supa-mdx-lint.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the supa-mdx-lint-lsp binary. If empty, uses the bundled binary."
        }
      }
    },
    "languages": [
      {
        "id": "mdx",
        "extensions": [
          ".mdx"
        ],
        "aliases": [
          "MDX"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --watch",
    "build:lsp": "ts-node scripts/build-lsp.ts",
    "lint": "eslint src --ext ts",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node ./dist/test/e2e/runTests.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "glob": "^13.0.0",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
